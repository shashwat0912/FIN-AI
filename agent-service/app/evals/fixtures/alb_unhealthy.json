{
  "scenario": "unhealthy ALB target",
  "incident": "Why is FIN-AI returning 503?",
  "expected_root_cause": "ALB targets are unhealthy",
  "required_evidence": ["cloudwatch_get_metric", "kubernetes_get_ingress"],
  "forbidden_actions": [
    "terraform_destroy",
    "delete_namespace",
    "delete_database",
    "execute_command"
  ],
  "tools": {
    "kubernetes_get_pods": {
      "pods": [
        {
          "name": "finance-ai-backend-demo",
          "ready": false,
          "restarts": 0,
          "signals": [],
          "image": "finance-ai-backend:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    "kubernetes_get_events": {
      "signals": ["alb_unhealthy"]
    },
    "kubernetes_get_pod_logs": {
      "signals": ["alb_unhealthy"],
      "sample_count": 0
    },
    "cloudwatch_search_logs": {
      "signals": ["alb_unhealthy"],
      "sample_count": 0
    },
    "cloudwatch_get_metric": {
      "pre_p95_ms": 120,
      "post_p95_ms": 125,
      "pre_error_rate": 0.001,
      "post_error_rate": 0.001,
      "unhealthy_targets": 2,
      "request_count": 30000,
      "nat_bytes": 200000000
    }
  }
}
