# Finance AI Dashboard - Frontend Environment Variables
# Copy this file to .env and update the values as needed

# OpenAI API Key (Optional - for AI Advisor feature)
# Get your API key from: https://platform.openai.com/api-keys
# Without this key, the AI Advisor page will show a friendly error message
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Firebase Configuration (Optional - for Firebase authentication)
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Backend API URL (Required)
# This should point to your backend server
VITE_API_URL=http://localhost:3000/api/v1

# Development Settings
# These are automatically set by Vite in development mode
# VITE_NODE_ENV=development
# VITE_DEV_SERVER_PORT=5173
