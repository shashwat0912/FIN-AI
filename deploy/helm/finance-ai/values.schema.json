{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["imagePullSecrets", "backend", "frontend", "ingress"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "backend": { "$ref": "#/definitions/backend" },
    "frontend": { "$ref": "#/definitions/frontend" },
    "ingress": { "$ref": "#/definitions/ingress" }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "not": { "const": "latest" }
        },
        "digest": {
          "type": "string",
          "anyOf": [{ "const": "" }, { "pattern": "^sha256:[a-fA-F0-9]{64}$" }]
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "anyOf": [
        {
          "properties": {
            "digest": { "pattern": "^sha256:[a-fA-F0-9]{64}$" }
          }
        },
        {
          "properties": {
            "tag": { "minLength": 1 }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourcePair" },
        "limits": { "$ref": "#/definitions/resourcePair" }
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold",
        "successThreshold"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "properties": {
            "eks.amazonaws.com/role-arn": {
              "type": "string",
              "pattern": "^arn:(aws|aws-us-gov|aws-cn):iam::[0-9]{12}:role/.+$"
            }
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "name": {
          "type": "string",
          "anyOf": [
            { "const": "" },
            {
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          ]
        }
      }
    },
    "backendConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NODE_ENV", "PORT", "API_VERSION", "CORS_ORIGIN"],
      "properties": {
        "NODE_ENV": { "const": "production" },
        "PORT": { "const": "3000" },
        "API_VERSION": { "type": "string", "minLength": 1 },
        "JWT_EXPIRES_IN": { "type": "string", "minLength": 1 },
        "JWT_REFRESH_EXPIRES_IN": { "type": "string", "minLength": 1 },
        "CORS_ORIGIN": { "type": "string", "pattern": "^https://" },
        "CORS_CREDENTIALS": { "type": "string", "enum": ["true", "false"] },
        "RATE_LIMIT_WINDOW_MS": { "type": "string", "pattern": "^[0-9]+$" },
        "RATE_LIMIT_MAX_REQUESTS": { "type": "string", "pattern": "^[0-9]+$" },
        "OPENAI_MODEL": { "type": "string", "minLength": 1 },
        "OPENAI_MAX_TOKENS": { "type": "string", "pattern": "^[0-9]+$" },
        "OPENAI_TIMEOUT_MS": { "type": "string", "pattern": "^[0-9]+$" },
        "AI_PROVIDER": {
          "type": "string",
          "enum": ["auto", "openai", "local"]
        },
        "EMBEDDING_PROVIDER": {
          "type": "string",
          "enum": ["auto", "openai", "local"]
        },
        "LOCAL_LLM_BASE_URL": { "type": "string", "minLength": 1 },
        "LOCAL_LLM_MODEL": { "type": "string", "minLength": 1 },
        "LOCAL_EMBEDDING_MODEL": { "type": "string", "minLength": 1 },
        "REDIS_AUTH_MODE": { "type": "string", "enum": ["url", "iam"] },
        "REDIS_HOST": { "type": "string", "minLength": 1 },
        "REDIS_PORT": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "REDIS_USERNAME": { "type": "string", "minLength": 1 },
        "REDIS_IAM_CACHE_NAME": { "type": "string", "minLength": 1 },
        "AWS_REGION": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$"
        },
        "LOG_LEVEL": {
          "type": "string",
          "enum": ["error", "warn", "info", "http", "verbose", "debug", "silly"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["REDIS_AUTH_MODE"],
            "properties": { "REDIS_AUTH_MODE": { "const": "iam" } }
          },
          "then": {
            "required": [
              "REDIS_HOST",
              "REDIS_PORT",
              "REDIS_USERNAME",
              "REDIS_IAM_CACHE_NAME",
              "AWS_REGION"
            ]
          }
        }
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "existingSecret",
        "serviceAccount",
        "image",
        "containerPort",
        "service",
        "config",
        "revisionHistoryLimit",
        "progressDeadlineSeconds",
        "terminationGracePeriodSeconds",
        "podSecurityContext",
        "securityContext",
        "resources",
        "probes"
      ],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "image": { "$ref": "#/definitions/image" },
        "containerPort": { "const": 3000 },
        "service": { "$ref": "#/definitions/service" },
        "config": { "$ref": "#/definitions/backendConfig" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 16 },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": { "$ref": "#/definitions/probes" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "serviceAccount",
        "image",
        "containerPort",
        "service",
        "revisionHistoryLimit",
        "progressDeadlineSeconds",
        "terminationGracePeriodSeconds",
        "podSecurityContext",
        "securityContext",
        "resources",
        "probes"
      ],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "image": { "$ref": "#/definitions/image" },
        "containerPort": { "const": 80 },
        "service": { "$ref": "#/definitions/service" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" },
        "probes": { "$ref": "#/definitions/probes" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "properties": { "hosts": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
