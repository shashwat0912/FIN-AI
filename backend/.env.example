# Backend development environment. Copy to .env; never commit the result.
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:local-only-postgres-password@localhost:5432/finance_ai_db?schema=public

# Generate independent values with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Development generates fresh process-only keys when blank; restart signs users out.
# Production requires independent operator-supplied values (minimum 64 characters).
JWT_SECRET=
JWT_REFRESH_SECRET=
SECURITY_STATE_HMAC_SECRET=replace-with-generated-state-hmac-secret-minimum-64-characters-before-use
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Browser origin and request protection
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
CSRF_SECRET=replace-with-generated-csrf-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI is optional. With no key, auto mode uses the deterministic local advisor.
AI_PROVIDER=auto
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT_MS=12000
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# OTP email delivery is optional in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Local Redis URL authentication. Deployed IAM settings are supplied by Helm.
REDIS_AUTH_MODE=url
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
LOG_FILE=logs/app.log
