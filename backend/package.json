{
  "name": "finance-ai-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for Finance AI Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "test:db:guard": "NODE_ENV=test tsx src/scripts/testDatabase.ts guard",
    "test:db:prepare": "NODE_ENV=test tsx src/scripts/testDatabase.ts deploy",
    "test:db:reset": "NODE_ENV=test tsx src/scripts/testDatabase.ts reset",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:prepare": "npm run test:db:prepare",
    "test": "npm run test:prepare && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration:prepare": "npm run test:db:reset",
    "test:integration": "npm run test:integration:prepare && RUN_INTEGRATION_TESTS=true vitest run tests/auth.test.ts tests/api/transactions.test.ts tests/services/budgetProjection.integration.test.ts tests/security/rateLimiting.test.ts --config vitest.config.ts --maxWorkers=1 --minWorkers=1",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:backfill-category-keys": "tsx src/scripts/backfillCategoryKeys.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:knowledge": "tsx src/scripts/seedKnowledge.ts",
    "rag:index": "node --loader tsx src/scripts/indexRagKnowledge.ts",
    "rag:backfill-embeddings": "node --loader tsx src/scripts/backfillRagEmbeddings.ts",
    "rag:eval": "node --loader tsx src/scripts/evaluateRag.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "test:ci": "vitest run --config ./vitest.config.ts"
  },
  "keywords": [
    "finance",
    "ai",
    "backend",
    "api",
    "typescript"
  ],
  "author": "Finance AI Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@types/luxon": "^3.7.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "openai": "^6.8.1",
    "pino": "^10.1.0",
    "pino-pretty": "^10.3.1",
    "prisma": "6.19.3",
    "stripe": "^14.9.0",
    "uuid": "^13.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
