# 🔒 Finance AI Backend - Environment Configuration
# 
# ⚠️  SECURITY WARNING: This file contains sensitive configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control!

# ===========================================
# 🚨 CRITICAL SECURITY CONFIGURATION
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
# For development: SQLite (file-based)
# For production: PostgreSQL or MySQL (URL format)
DATABASE_URL="file:./dev.db"
# ===========================================
# 🔐 JWT AUTHENTICATION (CRITICAL SECURITY)
# ===========================================
# 
# ⚠️  WARNING: These secrets MUST be cryptographically secure!
# Generate new secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters required for security
# NEVER use default or weak values in production!

# JWT Access Token Secret (64+ characters)
# IMPORTANT: Generate your own secret! Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_YOUR_OWN_64_CHAR_SECRET_GENERATE_USING_COMMAND_ABOVE_NEVER_USE_THIS_DEFAULT_VALUE

# JWT Refresh Token Secret (64+ characters) 
# IMPORTANT: Generate your own secret! Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=REPLACE_WITH_YOUR_OWN_64_CHAR_REFRESH_SECRET_GENERATE_USING_COMMAND_ABOVE_NEVER_USE_DEFAULT

# Token Expiration Times
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# 🌐 CORS CONFIGURATION
# ===========================================

# Allowed origins (comma-separated)
# Development: localhost ports
# Production: your actual domain(s)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
CORS_CREDENTIALS=true

# ===========================================
# 🛡️ CSRF PROTECTION
# ===========================================

# CSRF Secret (Required for multi-instance production deployments)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a random secret will be generated at startup (not recommended for production)
CSRF_SECRET=REPLACE_WITH_YOUR_OWN_CSRF_SECRET_FOR_PRODUCTION

# ===========================================
# 🛡️ RATE LIMITING
# ===========================================

# Rate limiting configuration (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# 🤖 AI SERVICES (Optional)
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT_MS=12000

# AI Provider Mode
# AI_PROVIDER: auto | openai | local
# - auto: use OpenAI when a real key exists, otherwise deterministic local advisor
# - openai: force OpenAI (will fail if key is invalid)
# - local: never call OpenAI
AI_PROVIDER=auto

# EMBEDDING_PROVIDER: auto | openai | local
# - local uses deterministic hash embeddings (no API key required)
EMBEDDING_PROVIDER=auto

# Optional local model settings (used only if you wire a local LLM server like Ollama)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ===========================================
# 💳 PAYMENT PROCESSING (Optional)
# ===========================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ===========================================
# 📧 EMAIL SERVICES (Optional)
# ===========================================

# SMTP Configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===========================================
# 📊 LOGGING & MONITORING
# ===========================================

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Sentry Error Monitoring (Production)
# Get your DSN from https://sentry.io - leave empty to disable
SENTRY_DSN=

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# ===========================================
# 🔧 SECURITY GENERATION COMMANDS
# ===========================================
#
# Generate new JWT secrets:
# node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('hex'))"
# node -e "console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(64).toString('hex'))"
#
# Generate random API keys:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ===========================================
# 🚀 PRODUCTION CHECKLIST
# ===========================================
#
# Before deploying to production:
# [ ] Generate new JWT secrets (never use example values)
# [ ] Generate new CSRF secret for multi-instance deployments
# [ ] Set up production database (PostgreSQL/MySQL)
# [ ] Configure CORS for your actual domain
# [ ] Set up SSL/HTTPS
# [ ] Configure proper logging
# [ ] Set up Sentry for error monitoring (SENTRY_DSN)
# [ ] Test all authentication flows
# [ ] Verify rate limiting works
# [ ] Check security headers
# [ ] Run security audit
#
# Frontend environment variables (VITE_ prefix):
# [ ] VITE_API_BASE_URL - Production API URL
# [ ] VITE_SENTRY_DSN - Sentry error monitoring (optional)
